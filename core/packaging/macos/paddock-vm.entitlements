<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The only entitlement of paddock-vm. The helper owns the Linux VM of a
  paddock sandbox, and the Virtualization framework needs this entitlement.
  An ad hoc signature (codesign -s -) is enough for it.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
