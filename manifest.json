{
  "schemaVersion": 1,
  "id": "harnessix.paddock",
  "name": "Paddock",
  "version": "0.1.1",
  "author": "harnessix",
  "license": "MIT",
  "description": "Runs coding agents and apps in paddock sandboxes: start, find and stop them, and answer their host requests.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "plugin/BarWidget.qml",
    "service": "plugin/Service.qml"
  },
  "barWidget": {
    "displayName": "Paddock",
    "description": "Running agent sandboxes and their host requests, with start, focus and stop actions.",
    "category": "AI",
    "aliases": [
      "paddock",
      "sandbox"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 10,
      "hideWhenIdle": "Show"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 300,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "hideWhenIdle",
        "type": "enum",
        "label": "Label when no sandbox runs",
        "options": [
          "Show",
          "Icon only"
        ],
        "defaultValue": "Show"
      }
    ]
  },
  "keepLoaded": true
}
