#!/usr/bin/env bash
# Install the paddock command from the copy of paddock in core/. The bar
# widget itself installs with `omarchy plugin add`.
set -euo pipefail
# paddock update reads the releases of this repository, which are built
# from the same core/.
export PADDOCK_RELEASE_REPO=harnessix/omarchy-paddock
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/core/bin/install" "$@"
