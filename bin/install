#!/usr/bin/env bash
# Install paddock and its system packages.
#
#   bin/install            required packages, desktop support, and paddock
#   bin/install --minimal  required packages and paddock only
#   bin/install --yes      do not ask before installing packages
#
# On Arch Linux the binary is installed as a package with makepkg. Elsewhere it
# is built with cargo and copied to ~/.local/bin.
#
# Omarchy (Arch Linux with Hyprland) is the supported platform. The apt and
# dnf paths are best effort: maintained by the community, not tested on every
# release.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
minimal=0
yes=0
for a in "$@"; do
  case "$a" in
    --minimal) minimal=1 ;;
    --yes | -y) yes=1 ;;
    -h | --help) sed -n '2,9p' "$0"; exit 0 ;;
    *) echo "bin/install: unknown option $a" >&2; exit 2 ;;
  esac
done

# The same lists as `paddock doctor` and pkgbuild/PKGBUILD.
if command -v pacman >/dev/null; then
  required=(git bubblewrap passt iproute2) desktop=(weston xorg-xwayland dbus gnome-keyring)
  install_cmd=(sudo pacman -S --needed)
  (( yes )) && install_cmd+=(--noconfirm)
elif command -v apt-get >/dev/null; then
  best_effort=1
  required=(git bubblewrap passt iproute2) desktop=(weston xwayland dbus gnome-keyring)
  install_cmd=(sudo apt-get install)
  (( yes )) && install_cmd+=(-y)
elif command -v dnf >/dev/null; then
  best_effort=1
  required=(git bubblewrap passt iproute) desktop=(weston xorg-x11-server-Xwayland dbus-daemon gnome-keyring)
  install_cmd=(sudo dnf install)
  (( yes )) && install_cmd+=(-y)
else
  echo "bin/install: no known package manager. Install git, bubblewrap and passt (pasta) yourself." >&2
  install_cmd=()
fi

if (( ${best_effort:-0} )); then
  echo ">>> Note: this distribution is supported on a best-effort basis. paddock is"
  echo "    tested on Omarchy (Arch Linux with Hyprland). See 'Support scope' in README.md."
fi

if (( ${#install_cmd[@]} )); then
  pkgs=("${required[@]}")
  (( minimal )) || pkgs+=("${desktop[@]}")
  echo ">>> Installing packages: ${pkgs[*]}"
  "${install_cmd[@]}" "${pkgs[@]}"
fi

if command -v makepkg >/dev/null; then
  echo ">>> Building and installing the Arch package"
  (cd "$root/pkgbuild" && makepkg -fsi $( (( yes )) && echo --noconfirm ))
else
  command -v cargo >/dev/null || { echo "bin/install: cargo is needed to build paddock" >&2; exit 1; }
  echo ">>> Building with cargo"
  (cd "$root" && cargo build --release --locked)
  install -Dm755 "$root/target/release/paddock" "$HOME/.local/bin/paddock"
  echo ">>> Installed $HOME/.local/bin/paddock"
fi

echo
paddock doctor || true
